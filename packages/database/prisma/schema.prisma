generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum DeploymentStatus {
  QUEUED
  CLONING
  ANALYZING
  BUILDING
  STARTING
  HEALTH_CHECKING
  READY
  FAILED
  CANCELLED
  STOPPED
  ROLLED_BACK
}

enum DeploymentLogLevel {
  INFO
  WARN
  ERROR
}

enum GitHubAccountType {
  USER
  ORGANIZATION
}

model User {
  id          String  @id @default(cuid())
  githubId    String  @unique
  username    String
  displayName String?
  email       String?
  avatarUrl   String?

  projects            Project[]
  sessions            Session[]
  githubInstallations GitHubInstallation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())

  // Only the SHA-256 hash is stored in the database.
  // The raw session token remains in the browser cookie.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model GitHubAuthState {
  id String @id @default(cuid())

  // Protects the GitHub authorization callback against CSRF.
  stateHash String @unique

  returnTo  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model GitHubInstallation {
  id String @id @default(cuid())

  // GitHub numeric IDs are stored as strings to avoid
  // BigInt serialization problems between Prisma, NestJS and Nuxt.
  installationId String            @unique
  accountId      String
  accountLogin   String
  accountType    GitHubAccountType
  avatarUrl      String?

  repositorySelection String    @default("selected")
  suspendedAt         DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([accountLogin])
}

model Project {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  repositoryOwner  String
  repositoryName   String
  repositoryUrl    String
  repositoryId     String?
  productionBranch String  @default("main")
  rootDirectory    String  @default(".")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable so existing manually created projects remain valid.
  githubInstallationId String?
  githubInstallation   GitHubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)

  deployments Deployment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, repositoryOwner, repositoryName])
  @@index([userId])
  @@index([githubInstallationId])
}

model Deployment {
  id        String           @id @default(cuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    DeploymentStatus @default(QUEUED)
  branch    String

  commitSha     String?
  commitMessage String?
  imageTag      String?
  containerId   String?
  assignedPort  Int?
  liveUrl       String?
  errorCode     String?
  errorMessage  String?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  analysis DeploymentAnalysis?
  logs     DeploymentLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([status])
}

model DeploymentAnalysis {
  id           String     @id @default(cuid())
  deploymentId String     @unique
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  projectType     String
  framework       String
  packageManager  String
  installCommand  String
  buildCommand    String?
  startCommand    String?
  applicationPort Int?
  hasDockerfile   Boolean
  rootDirectory   String  @default(".")
  warnings        Json

  discoveredApplications Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeploymentLog {
  id           String     @id @default(cuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  level   DeploymentLogLevel @default(INFO)
  stage   String
  message String

  createdAt DateTime @default(now())

  @@index([deploymentId, createdAt])
}

model GitHubWebhookDelivery {
  id           String    @id @default(cuid())
  deliveryId   String    @unique
  event        String
  repositoryId String
  projectId    String?
  deploymentId String?
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([repositoryId])
  @@index([projectId])
  @@index([deploymentId])
  @@index([createdAt])
}
