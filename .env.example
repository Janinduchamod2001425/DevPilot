NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://devpilot:devpilot@localhost:5433/devpilot?schema=public
REDIS_HOST=localhost
REDIS_PORT=6380
NUXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

DEV_SEED_REPOSITORY_URL=https://github.com/your-username/your-repository
DEV_SEED_REPOSITORY_BRANCH=main

DEPLOYMENT_WORKSPACE_ROOT=../../.devpilot/workspaces

DEV_SEED_ROOT_DIRECTORY=apps/dashboard

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# GitHub App URLs
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
GITHUB_SETUP_URL=http://localhost:4000/api/github/setup
GITHUB_WEBHOOK_URL=

# DevPilot authentication
SESSION_COOKIE_NAME=devpilot_session
SESSION_DURATION_DAYS=30
DASHBOARD_URL=http://localhost:3001

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_DIAGNOSIS_MODEL=gemini-2.5-flash
